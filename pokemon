def print_completion(args):
    """print_completion(args) -> prints the shell completion script"""
    print(ZSH_COMPLETION if args.shell == 'zsh' else BASH_COMPLETION, end='')


###########################################
if __name__ == '__main__':
    # hidden command used by the shell completion: pokemon __complete STATUS [PROFILE]
    if len(sys.argv) >= 3 and sys.argv[1] == '__complete':
        profile = sys.argv[3] if len(sys.argv) > 3 else os.environ.get('POKEMON_PROXXX_PROFILE')
        complete_vms(argparse.Namespace(profile=profile), sys.argv[2])
        sys.exit(0)

    parser = argparse.ArgumentParser(
        prog="pokemon",
        description='Management script for Pokemon VMs')
    parser.add_argument('--profile', default=os.environ.get('POKEMON_PROXXX_PROFILE'),
                        help='proxxx connection profile (default: $POKEMON_PROXXX_PROFILE or proxxx\'s default)')
    subparsers = parser.add_subparsers(help='sub-command help')

    parser_connect = subparsers.add_parser('connect', help="connect to a VM")
    parser_connect.add_argument('-l', '--user', default=os.environ.get('POKEMON_VM_USER', getpass.getuser()),
                                help='user name in the VM (default: $POKEMON_VM_USER or local user name)')
    parser_connect.add_argument('-n', '--dry-run', action='store_true',
                                help='only print the ssh command')
    parser_connect.add_argument('vm_name', nargs='?', help='VM name (default: choose interactively)')
    parser_connect.add_argument('ssh_args', nargs=argparse.REMAINDER,
                                help='further arguments passed to ssh (e.g., a command)')
    parser_connect.set_defaults(func=connect_to_vm)

    parser_mount = subparsers.add_parser('mount', help="mount a VM's filesystem via sshfs")
    parser_mount.add_argument('-l', '--user', default=os.environ.get('POKEMON_VM_USER', getpass.getuser()),
                              help='user name in the VM (default: $POKEMON_VM_USER or local user name)')
    parser_mount.add_argument('-n', '--dry-run', action='store_true',
                              help='only print the sshfs command')
    parser_mount.add_argument('-o', dest='options', action='append', default=[],
                              help='sshfs option (can be repeated)')
    parser_mount.add_argument('vm_name', nargs='?', help='VM name (default: choose interactively)')
    parser_mount.add_argument('remote_path', nargs='?', default='',
                              help='directory in the VM (default: the user\'s home)')
    parser_mount.add_argument('mountpoint', nargs='?', default=os.path.join(os.path.expanduser('~'), 'mnt'),
                              help='local directory (default: $HOME/mnt)')
    parser_mount.set_defaults(func=mount_vm)

    parser_start = subparsers.add_parser('start', help="start a VM")
    parser_start.add_argument('vm_name', nargs='?', help='VM name (default: choose from stopped VMs)')
    parser_start.set_defaults(func=start_vm)

    parser_stop = subparsers.add_parser('stop', help="shut a VM down")
    parser_stop.add_argument('-f', '--force', action='store_true',
                             help='kill the VM immediately instead of a graceful shutdown')
    parser_stop.add_argument('-t', '--timeout', type=int, default=60,
                             help='seconds to wait for a graceful shutdown before killing the VM (default: 60)')
    parser_stop.add_argument('--allow-risk', action='store_true',
                             help='override proxxx\'s pre-flight checks (e.g., a locked or HA-managed VM)')
    parser_stop.add_argument('vm_name', nargs='?', help='VM name (default: choose from running VMs)')
    parser_stop.set_defaults(func=stop_vm)

    parser_rm = subparsers.add_parser('rm', help="remove a VM (asks for confirmation)")
    parser_rm.add_argument('--allow-risk', action='store_true',
                           help='override proxxx\'s pre-flight checks (e.g., a locked or HA-managed VM)')
    parser_rm.add_argument('vm_name', nargs='?', help='VM name (default: choose from stopped VMs)')
    parser_rm.set_defaults(func=remove_vm)

    parser_cluster = subparsers.add_parser('cluster', help="show the cluster's nodes and storages")
    parser_cluster.set_defaults(func=show_cluster)

    parser_list = subparsers.add_parser('list', help="list VMs")
    parser_list.add_argument('-r', '--running', action='store_true',
                             help='only running VMs')
    parser_list.add_argument('-L', '--last-run', action='store_true',
                             help='show when each VM was last running (slower; "-" = not in the last year)')
    parser_list.set_defaults(func=list_vms)

    parser_completion = subparsers.add_parser(
        'completion', help="print a shell completion script",
        description='Print a completion script; enable it by adding '
                    '`eval "$(pokemon completion zsh)"` (or bash) to ~/.zshrc (~/.bashrc).')
    parser_completion.add_argument('shell', choices=['bash', 'zsh'])
    parser_completion.set_defaults(func=print_completion)

    args = parser.parse_args()
    if not hasattr(args, 'func'):
        parser.print_help()
        sys.exit(1)
    args.func(args)
