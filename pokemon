#!/usr/bin/env python3
"""pokemon - connect to VMs in VeriFIT's Proxmox cluster.

All Proxmox queries go through proxxx (https://github.com/fabriziosalmi/proxxx),
which holds the cluster URL and API token in its own config
(~/.config/proxxx/config.toml, or $PROXXX_CONFIG).
"""

import argparse
import curses
import getpass
import ipaddress
import json
import os
import shutil
import subprocess
import sys

PROXXX = os.environ.get('POKEMON_PROXXX', 'proxxx')
DOMAIN = 'fit.vutbr.cz'

# VMs live in 10.10.10.0/24; a node forwards its port PORT_BASE + <last octet>
# to port 22 of the VM with that address
VM_NETWORK = ipaddress.ip_network('10.10.10.0/24')
PORT_BASE = 6000


###########################################
def die(msg):
    print(f"pokemon: {msg}", file=sys.stderr)
    sys.exit(1)


###########################################
def proxxx(args, *cmd):
    """proxxx(args, *cmd) -> the JSON result of `proxxx <cmd>`"""
    if shutil.which(PROXXX) is None:
        die(f"'{PROXXX}' not found; install proxxx from "
            "https://github.com/fabriziosalmi/proxxx/releases or set $POKEMON_PROXXX")

    argv = [PROXXX, '--format', 'json']
    if args.profile:
        argv += ['--profile', args.profile]
    argv += cmd

    # proxxx logs at INFO level to stderr by default
    env = dict(os.environ)
    env.setdefault('RUST_LOG', 'proxxx=error')

    proc = subprocess.run(argv, stdout=subprocess.PIPE, env=env, text=True)
    try:
        result = json.loads(proc.stdout)
    except json.JSONDecodeError:
        die(f"unexpected output of '{' '.join(argv)}' (exit code {proc.returncode})")

    # in JSON mode, proxxx reports errors as [{"status": "fatal_error", ...}]
    if result and isinstance(result[0], dict) and result[0].get('status') == 'fatal_error':
        msg = result[0].get('error', 'unknown error')
        if 'hint' in result[0]:
            msg += f"\n  hint: {result[0]['hint']}"
        die(f"proxxx: {msg}")
    if proc.returncode != 0:
        die(f"'{' '.join(argv)}' failed with exit code {proc.returncode}")
    return result


###########################################
def get_vms(args):
    """get_vms(args) -> list of QEMU VMs (not templates) on online nodes"""
    return [g for g in proxxx(args, 'ls', 'guests')
            if g.get('type') == 'qemu' and not g.get('template')]


###########################################
def format_vm(vm, width):
    return f"{vm['name']:<{width}}  {vm['vmid']:>5}  {vm['node']:<10}  {vm['status']}"


###########################################
def select_vm(vms):
    """select_vm(vms) -> a VM from vms chosen interactively (via fzf if available)"""
    if not vms:
        die("no running VMs")
    if not sys.stdin.isatty():
        die("no VM name given and stdin is not a terminal")

    vms = sorted(vms, key=lambda vm: vm['name'])
    width = max(len(vm['name']) for vm in vms)
    lines = [format_vm(vm, width) for vm in vms]

    if shutil.which("fzf"):
        proc = subprocess.run(["fzf", "--prompt=VM> ", "--height=40%", "--reverse"],
                              input="\n".join(lines), stdout=subprocess.PIPE, text=True)
        if proc.returncode != 0:    # nothing selected (Esc / Ctrl-C)
            sys.exit(1)
        return vms[lines.index(proc.stdout.rstrip("\n"))]

    if not sys.stdout.isatty():
        die("no VM name given and stdout is not a terminal (install fzf or give a VM name)")
    os.environ.setdefault('ESCDELAY', '25')    # make Esc respond without curses' default 1s delay
    try:
        idx = curses.wrapper(menu, lines)
    except KeyboardInterrupt:
        idx = None
    if idx is None:
        sys.exit(1)
    return vms[idx]


###########################################
def menu(scr, lines):
    """menu(scr, lines) -> index of the line chosen in a curses menu, None if cancelled

Arrows/PgUp/PgDn/Home/End move, Enter selects, Esc cancels, typing filters.
"""
    curses.curs_set(0)
    query = ""
    cur = 0      # position of the cursor in the filtered list
    top = 0      # first visible line of the filtered list
    while True:
        shown = [i for (i, line) in enumerate(lines) if query.lower() in line.lower()]
        (height, width) = scr.getmaxyx()
        rows = max(height - 1, 1)
        cur = max(0, min(cur, len(shown) - 1))
        top = max(min(top, cur), cur - rows + 1, 0)

        scr.erase()
        scr.addnstr(0, 0, f"VM> {query}  ({len(shown)}/{len(lines)})", width - 1, curses.A_BOLD)
        for (row, i) in enumerate(shown[top:top + rows], 1):
            if row >= height:
                break
            attr = curses.A_REVERSE if top + row - 1 == cur else curses.A_NORMAL
            scr.addnstr(row, 0, lines[i], width - 1, attr)
        scr.refresh()

        key = scr.get_wch()
        if key in (curses.KEY_UP, '\x10'):                 # Ctrl-P
            cur -= 1
        elif key in (curses.KEY_DOWN, '\x0e'):             # Ctrl-N
            cur += 1
        elif key == curses.KEY_PPAGE:
            cur -= rows
        elif key == curses.KEY_NPAGE:
            cur += rows
        elif key == curses.KEY_HOME:
            cur = 0
        elif key == curses.KEY_END:
            cur = len(shown) - 1
        elif key in ('\n', '\r', curses.KEY_ENTER):
            if shown:
                return shown[cur]
        elif key == '\x1b':                                # Esc
            return None
        elif key in (curses.KEY_BACKSPACE, '\x7f', '\b'):
            query = query[:-1]
        elif isinstance(key, str) and key.isprintable():
            query += key
            cur = 0


###########################################
def find_vm(args, vmname):
    """find_vm(args, vmname) -> the proxxx guest record of the VM (chosen interactively if vmname is None)"""
    if vmname is None:
        return select_vm([vm for vm in get_vms(args) if vm['status'] == 'running'])

    vms = [vm for vm in get_vms(args) if vm.get('name') == vmname]
    if not vms:
        die(f"VM '{vmname}' not found (VMs on offline nodes are not visible)")
    if len(vms) > 1:
        ids = ", ".join(str(vm['vmid']) for vm in vms)
        die(f"VM name '{vmname}' is ambiguous (VM IDs {ids})")
    return vms[0]


###########################################
def get_vm_ip(args, vm):
    """get_vm_ip(args, vm) -> the VM's address in VM_NETWORK (via the guest agent)"""
    if vm['status'] != 'running':
        die(f"VM '{vm['name']}' is {vm['status']}, not running")

    (res,) = proxxx(args, 'qga', str(vm['vmid']), 'net')
    for ifc in res['interfaces']:
        for ip_addr in ifc.get('ip-addresses', []):
            addr = ipaddress.ip_address(ip_addr['ip-address'])
            if addr in VM_NETWORK:
                return addr

    die(f"VM '{vm['name']}' has no address in {VM_NETWORK}")


###########################################
def get_node_port_for_vm(args, vmname):
    """get_node_port_for_vm(args, vmname) -> (node, port) to ssh to in order to reach the VM"""
    vm = find_vm(args, vmname)
    addr = get_vm_ip(args, vm)
    port_offset = int(addr) - int(VM_NETWORK.network_address)
    return (vm['node'], PORT_BASE + port_offset)


###########################################
def connect_to_vm(args):
    """connect_to_vm(args) -> replaces the process with ssh to the VM"""
    (node, port) = get_node_port_for_vm(args, args.vm_name)

    ssh_args = ["ssh", "-p", f"{port}", f"{args.user}@{node}.{DOMAIN}", *args.ssh_args]
    if args.dry_run:
        print(" ".join(ssh_args))
        return
    os.execvp("ssh", ssh_args)


###########################################
def mount_vm(args):
    """mount_vm(args) -> mounts the VM's filesystem via sshfs"""
    (node, port) = get_node_port_for_vm(args, args.vm_name)

    sshfs_args = ["sshfs", "-p", f"{port}", f"{args.user}@{node}.{DOMAIN}:{args.remote_path}",
                  args.mountpoint]
    for opt in args.options:
        sshfs_args += ["-o", opt]
    if args.dry_run:
        print(" ".join(sshfs_args))
        return

    if shutil.which("sshfs") is None:
        die("'sshfs' not found; install it (e.g., `apt install sshfs`)")
    if os.path.ismount(args.mountpoint):
        die(f"'{args.mountpoint}' is already a mount point")
    os.makedirs(args.mountpoint, exist_ok=True)
    os.execvp("sshfs", sshfs_args)


###########################################
def list_vms(args):
    """list_vms(args) -> prints the VMs in the cluster"""
    vms = sorted(get_vms(args), key=lambda vm: vm['name'])
    if args.running:
        vms = [vm for vm in vms if vm['status'] == 'running']
    width = max((len(vm['name']) for vm in vms), default=0)
    for vm in vms:
        print(format_vm(vm, width))


###########################################
if __name__ == '__main__':
    parser = argparse.ArgumentParser(
        prog="pokemon",
        description='Management script for Pokemon VMs')
    parser.add_argument('--profile', default=os.environ.get('POKEMON_PROXXX_PROFILE'),
                        help='proxxx connection profile (default: $POKEMON_PROXXX_PROFILE or proxxx\'s default)')
    subparsers = parser.add_subparsers(help='sub-command help')

    parser_connect = subparsers.add_parser('connect', help="connect to a VM")
    parser_connect.add_argument('-l', '--user', default=os.environ.get('POKEMON_VM_USER', getpass.getuser()),
                                help='user name in the VM (default: $POKEMON_VM_USER or local user name)')
    parser_connect.add_argument('-n', '--dry-run', action='store_true',
                                help='only print the ssh command')
    parser_connect.add_argument('vm_name', nargs='?', help='VM name (default: choose interactively)')
    parser_connect.add_argument('ssh_args', nargs=argparse.REMAINDER,
                                help='further arguments passed to ssh (e.g., a command)')
    parser_connect.set_defaults(func=connect_to_vm)

    parser_mount = subparsers.add_parser('mount', help="mount a VM's filesystem via sshfs")
    parser_mount.add_argument('-l', '--user', default=os.environ.get('POKEMON_VM_USER', getpass.getuser()),
                              help='user name in the VM (default: $POKEMON_VM_USER or local user name)')
    parser_mount.add_argument('-n', '--dry-run', action='store_true',
                              help='only print the sshfs command')
    parser_mount.add_argument('-o', dest='options', action='append', default=[],
                              help='sshfs option (can be repeated)')
    parser_mount.add_argument('vm_name', nargs='?', help='VM name (default: choose interactively)')
    parser_mount.add_argument('remote_path', nargs='?', default='',
                              help='directory in the VM (default: the user\'s home)')
    parser_mount.add_argument('mountpoint', nargs='?', default=os.path.join(os.path.expanduser('~'), 'mnt'),
                              help='local directory (default: $HOME/mnt)')
    parser_mount.set_defaults(func=mount_vm)

    parser_list = subparsers.add_parser('list', help="list VMs")
    parser_list.add_argument('-r', '--running', action='store_true',
                             help='only running VMs')
    parser_list.set_defaults(func=list_vms)

    args = parser.parse_args()
    if not hasattr(args, 'func'):
        parser.print_help()
        sys.exit(1)
    args.func(args)
