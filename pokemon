###########################################
def get_node_port_for_vm(vmname):
    vms = prox.cluster.resources.get(type="vm")
    # print(vms)
    for vm in vms:
    # for vm in prox.cluster.resources.get(type="vm"):
        # print(f"Looking at VM {vm['name']}")
        if vm['name'] == vmname:
            node = vm['node']
            netifcs = prox.nodes(node).qemu(vm['vmid']).agent("network-get-interfaces").get()
            # print(netifcs)
            for ifc in netifcs['result']:
                # print(ifc)
                for ip_addr in ifc['ip-addresses']:
                    # print(ip_addr)
                    m = re.match("10\.10\.10\.(.*)", ip_addr['ip-address'])
                    if m:
                        # print(ip_addr['ip-address'])
                        port_offset = int(m[1])

            return (node, PORT_BASE + port_offset)

###########################################
def connect_to_vm(args):
    """connect_to_vm(args) ->


"""
    # print(get_ssh_connection(args.vm_name))
    (node, port) = get_node_port_for_vm(args.vm_name)

    ssh_args = ["ssh", f"{VM_USER}@{node}.{DOMAIN}", "-p", f"{port}"]
    # print(ssh_args)
    os.execvp("ssh", ssh_args)


