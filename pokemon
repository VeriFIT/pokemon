#!/usr/bin/env python3
"""pokemon - connect to VMs in VeriFIT's Proxmox cluster.

All Proxmox queries go through proxxx (https://github.com/fabriziosalmi/proxxx),
which holds the cluster URL and API token in its own config
(~/.config/proxxx/config.toml, or $PROXXX_CONFIG).
"""

import argparse
import concurrent.futures
import curses
import datetime
import getpass
import ipaddress
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

PROXXX = os.environ.get('POKEMON_PROXXX', 'proxxx')
DOMAIN = 'fit.vutbr.cz'

# VMs live in 10.10.10.0/24; a node forwards its port PORT_BASE + <last octet>
# to port 22 of the VM with that address
VM_NETWORK = ipaddress.ip_network('10.10.10.0/24')
PORT_BASE = 6000

# how long (in seconds) shell completion reuses the cached list of VMs
COMPLETION_CACHE_TTL = 60


###########################################
def die(msg):
    print(f"pokemon: {msg}", file=sys.stderr)
    sys.exit(1)


###########################################
def proxxx(args, *cmd, check=True):
    """proxxx(args, *cmd, check=True) -> the JSON result of `proxxx <cmd>`

Unless check is False, a non-zero exit code of proxxx is fatal.
"""
    if shutil.which(PROXXX) is None:
        die(f"'{PROXXX}' not found; install proxxx from "
            "https://github.com/fabriziosalmi/proxxx/releases or set $POKEMON_PROXXX")

    argv = [PROXXX, '--format', 'json']
    if args.profile:
        argv += ['--profile', args.profile]
    argv += cmd

    # proxxx logs at INFO level to stderr by default
    env = dict(os.environ)
    env.setdefault('RUST_LOG', 'proxxx=error')

    proc = subprocess.run(argv, stdout=subprocess.PIPE, env=env, text=True)
    try:
        result = json.loads(proc.stdout)
    except json.JSONDecodeError:
        die(f"unexpected output of '{' '.join(argv)}' (exit code {proc.returncode})")

    # in JSON mode, proxxx reports errors as [{"status": "fatal_error", ...}]
    if result and isinstance(result[0], dict) and result[0].get('status') == 'fatal_error':
        msg = result[0].get('error', 'unknown error')
        if 'hint' in result[0]:
            msg += f"\n  hint: {result[0]['hint']}"
        die(f"proxxx: {msg}")
    if check and proc.returncode != 0:
        die(f"'{' '.join(argv)}' failed with exit code {proc.returncode}")
    return result


###########################################
def get_vms(args):
    """get_vms(args) -> list of QEMU VMs (not templates) on online nodes"""
    return [g for g in proxxx(args, 'ls', 'guests')
            if g.get('type') == 'qemu' and not g.get('template')]


###########################################
def format_vm(vm, width):
    return f"{vm['name']:<{width}}  {vm['vmid']:>5}  {vm['node']:<10}  {vm['status']}"


def format_header(width):
    return f"{'NAME':<{width}}  {'VMID':>5}  {'NODE':<10}  STATUS"


###########################################
def select_vm(vms, status):
    """select_vm(vms, status) -> a VM from vms (with the given status) chosen interactively (via fzf if available)"""
    if not vms:
        die(f"no {status} VMs")
    if not sys.stdin.isatty():
        die("no VM name given and stdin is not a terminal")

    vms = sorted(vms, key=lambda vm: vm['name'])
    width = max(len(vm['name']) for vm in vms + [{'name': 'NAME'}])
    lines = [format_vm(vm, width) for vm in vms]

    if shutil.which("fzf"):
        proc = subprocess.run(["fzf", "--prompt=VM> ", "--height=40%", "--reverse",
                               f"--header={format_header(width)}"],
                              input="\n".join(lines), stdout=subprocess.PIPE, text=True)
        if proc.returncode != 0:    # nothing selected (Esc / Ctrl-C)
            sys.exit(1)
        return vms[lines.index(proc.stdout.rstrip("\n"))]

    if not sys.stdout.isatty():
        die("no VM name given and stdout is not a terminal (install fzf or give a VM name)")
    os.environ.setdefault('ESCDELAY', '25')    # make Esc respond without curses' default 1s delay
    try:
        idx = curses.wrapper(menu, format_header(width), lines)
    except KeyboardInterrupt:
        idx = None
    if idx is None:
        sys.exit(1)
    return vms[idx]


###########################################
def menu(scr, header, lines):
    """menu(scr, header, lines) -> index of the line chosen in a curses menu, None if cancelled

Arrows/PgUp/PgDn/Home/End move, Enter selects, Esc cancels, typing filters.
"""
    curses.curs_set(0)
    query = ""
    cur = 0      # position of the cursor in the filtered list
    top = 0      # first visible line of the filtered list
    while True:
        shown = [i for (i, line) in enumerate(lines) if query.lower() in line.lower()]
        (height, width) = scr.getmaxyx()
        rows = max(height - 2, 1)
        cur = max(0, min(cur, len(shown) - 1))
        top = max(min(top, cur), cur - rows + 1, 0)

        scr.erase()
        scr.addnstr(0, 0, f"VM> {query}  ({len(shown)}/{len(lines)})", width - 1, curses.A_BOLD)
        if height > 1:
            scr.addnstr(1, 0, header, width - 1, curses.A_UNDERLINE)
        for (row, i) in enumerate(shown[top:top + rows], 2):
            if row >= height:
                break
            attr = curses.A_REVERSE if top + row - 2 == cur else curses.A_NORMAL
            scr.addnstr(row, 0, lines[i], width - 1, attr)
        scr.refresh()

        key = scr.get_wch()
        if key in (curses.KEY_UP, '\x10'):                 # Ctrl-P
            cur -= 1
        elif key in (curses.KEY_DOWN, '\x0e'):             # Ctrl-N
            cur += 1
        elif key == curses.KEY_PPAGE:
            cur -= rows
        elif key == curses.KEY_NPAGE:
            cur += rows
        elif key == curses.KEY_HOME:
            cur = 0
        elif key == curses.KEY_END:
            cur = len(shown) - 1
        elif key in ('\n', '\r', curses.KEY_ENTER):
            if shown:
                return shown[cur]
        elif key == '\x1b':                                # Esc
            return None
        elif key in (curses.KEY_BACKSPACE, '\x7f', '\b'):
            query = query[:-1]
        elif isinstance(key, str) and key.isprintable():
            query += key
            cur = 0


###########################################
def find_vm(args, vmname, status='running'):
    """find_vm(args, vmname, status) -> the proxxx guest record of the VM

If vmname is None, the VM is chosen interactively from VMs with the given status.
"""
    if vmname is None:
        return select_vm([vm for vm in get_vms(args) if vm['status'] == status], status)

    vms = [vm for vm in get_vms(args) if vm.get('name') == vmname]
    if not vms:
        die(f"VM '{vmname}' not found (VMs on offline nodes are not visible)")
    if len(vms) > 1:
        ids = ", ".join(str(vm['vmid']) for vm in vms)
        die(f"VM name '{vmname}' is ambiguous (VM IDs {ids})")
    return vms[0]


###########################################
def get_vm_ip(args, vm):
    """get_vm_ip(args, vm) -> the VM's address in VM_NETWORK (via the guest agent)"""
    if vm['status'] != 'running':
        die(f"VM '{vm['name']}' is {vm['status']}, not running")

    (res,) = proxxx(args, 'qga', str(vm['vmid']), 'net')
    for ifc in res['interfaces']:
        for ip_addr in ifc.get('ip-addresses', []):
            addr = ipaddress.ip_address(ip_addr['ip-address'])
            if addr in VM_NETWORK:
                return addr

    die(f"VM '{vm['name']}' has no address in {VM_NETWORK}")


###########################################
def get_node_port_for_vm(args, vmname):
    """get_node_port_for_vm(args, vmname) -> (node, port) to ssh to in order to reach the VM"""
    vm = find_vm(args, vmname)
    addr = get_vm_ip(args, vm)
    port_offset = int(addr) - int(VM_NETWORK.network_address)
    return (vm['node'], PORT_BASE + port_offset)


###########################################
def connect_to_vm(args):
    """connect_to_vm(args) -> replaces the process with ssh to the VM"""
    (node, port) = get_node_port_for_vm(args, args.vm_name)

    ssh_args = ["ssh", "-p", f"{port}", f"{args.user}@{node}.{DOMAIN}", *args.ssh_args]
    if args.dry_run:
        print(" ".join(ssh_args))
        return
    os.execvp("ssh", ssh_args)


###########################################
def mount_vm(args):
    """mount_vm(args) -> mounts the VM's filesystem via sshfs"""
    (node, port) = get_node_port_for_vm(args, args.vm_name)

    sshfs_args = ["sshfs", "-p", f"{port}", f"{args.user}@{node}.{DOMAIN}:{args.remote_path}",
                  args.mountpoint]
    for opt in args.options:
        sshfs_args += ["-o", opt]
    if args.dry_run:
        print(" ".join(sshfs_args))
        return

    if shutil.which("sshfs") is None:
        die("'sshfs' not found; install it (e.g., `apt install sshfs`)")
    if os.path.ismount(args.mountpoint):
        die(f"'{args.mountpoint}' is already a mount point")
    os.makedirs(args.mountpoint, exist_ok=True)
    os.execvp("sshfs", sshfs_args)


###########################################
def vm_task(args, vm, action, *cmd):
    """vm_task(args, vm, action, *cmd) -> runs `proxxx <cmd> <vmid>` (start/stop/delete) and reports the result"""
    results = proxxx(args, *cmd, str(vm['vmid']), check=False)
    for res in results:
        if res.get('status') == 'success':
            print(f"pokemon: {action} of VM '{vm['name']}' requested (task {res.get('upid')})")
        elif res.get('status') == 'pending_hitl':
            print(f"pokemon: {action} of VM '{vm['name']}' waits for approval: {res.get('message')}")
        else:
            die(f"{action} of VM '{vm['name']}' failed: "
                f"{res.get('message') or res.get('reason') or res.get('error')}")
    invalidate_completion_cache(args)


###########################################
def start_vm(args):
    """start_vm(args) -> starts the VM"""
    vm = find_vm(args, args.vm_name, status='stopped')
    if vm['status'] == 'running':
        die(f"VM '{vm['name']}' is already running")
    vm_task(args, vm, 'start', 'start')


###########################################
def stop_vm(args):
    """stop_vm(args) -> shuts the VM down (or kills it with --force)"""
    vm = find_vm(args, args.vm_name, status='running')
    if vm['status'] == 'stopped':
        die(f"VM '{vm['name']}' is already stopped")
    cmd = ['stop', '--stop-timeout', str(args.timeout)]
    if args.force:
        cmd.append('--force')
    if args.allow_risk:
        cmd.append('--allow-risk')
    vm_task(args, vm, 'stop', *cmd)


###########################################
def remove_vm(args):
    """remove_vm(args) -> deletes the VM after the user confirms by typing its ID"""
    vm = find_vm(args, args.vm_name, status='stopped')
    if vm['status'] != 'stopped':
        die(f"VM '{vm['name']}' is {vm['status']}; stop it first (pokemon stop {vm['name']})")
    if not sys.stdin.isatty():
        die("removal must be confirmed interactively, but stdin is not a terminal")

    print(f"VM '{vm['name']}' (ID {vm['vmid']}, node {vm['node']}"
          + (f", tags {vm['tags']}" if vm.get('tags') else "") + ")"
          " and all its disks will be removed permanently.", file=sys.stderr)
    try:
        answer = input(f"Type the VM ID ({vm['vmid']}) to confirm: ")
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        answer = None
    if answer is None or answer.strip() != str(vm['vmid']):
        die("not confirmed, nothing removed")

    cmd = ['delete', '--yes']
    if args.allow_risk:
        cmd.append('--allow-risk')
    vm_task(args, vm, 'removal', *cmd)


###########################################
def get_last_run(args, vm):
    """get_last_run(args, vm) -> string with the last time the VM was running

Taken from the VM's RRD statistics: the newest sample with memory in use.
'month' has 12-hour samples, 'year' ~weekly ones (marked with '~').
"""
    if vm['status'] == 'running':
        return "now"
    for (timeframe, prefix) in (('month', ''), ('year', '~')):
        (res,) = proxxx(args, 'metrics', 'vm', str(vm['vmid']), '--node', vm['node'],
                        '--field', 'mem', '--timeframe', timeframe, '--cf', 'max')
        times = [pt['time'] for pt in res['points'] if pt.get('value')]
        if times:
            return prefix + datetime.date.fromtimestamp(max(times)).isoformat()
    return "-"


###########################################
def list_vms(args):
    """list_vms(args) -> prints the VMs in the cluster"""
    vms = sorted(get_vms(args), key=lambda vm: vm['name'])
    if args.running:
        vms = [vm for vm in vms if vm['status'] == 'running']
    width = max((len(vm['name']) for vm in vms + [{'name': 'NAME'}]))

    if args.last_run:
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            last_runs = list(pool.map(lambda vm: get_last_run(args, vm), vms))
        print(f"{format_header(width):<{width + 30}}  LAST RUNNING")
        for (vm, last_run) in zip(vms, last_runs):
            print(f"{format_vm(vm, width):<{width + 30}}  {last_run}")
    else:
        print(format_header(width))
        for vm in vms:
            print(format_vm(vm, width))


###########################################
def usage(used, total):
    """usage(used, total) -> 'used/total unit (pct%)', both in the unit that suits total"""
    if not total:
        return "-"
    (scaled_used, scaled_total) = (used, total)
    for unit in ('B', 'KiB', 'MiB', 'GiB', 'TiB'):
        if scaled_total < 1024 or unit == 'TiB':
            break
        (scaled_used, scaled_total) = (scaled_used / 1024, scaled_total / 1024)

    def num(x):
        return f"{x:.1f}" if x < 10 else f"{x:.0f}"
    return f"{num(scaled_used)}/{num(scaled_total)} {unit} ({100 * used / total:.0f}%)"


def print_table(header, rows):
    """print_table(header, rows) -> prints rows (lists of strings) with aligned columns"""
    widths = [max(len(row[i]) for row in [header] + rows) for i in range(len(header))]
    for row in [header] + rows:
        print("  ".join(cell.ljust(width) for (cell, width) in zip(row, widths)).rstrip())


###########################################
def show_cluster(args):
    """show_cluster(args) -> prints nodes with their CPU/memory/disk/(local) storage usage"""
    (res,) = proxxx(args, 'cluster-resources')    # [{"count": N, "resources": [...]}]
    resources = res['resources']
    nodes = sorted((r for r in resources if r['type'] == 'node'), key=lambda r: r['node'])
    # shared storages (NFS, ...) are not specific to a node and 'local' is the
    # root disk, so they are left out
    shared = {s['storage'] for s in proxxx(args, 'ls', 'storage') if s.get('shared')}
    storages = {(r['node'], r['storage']): r for r in resources
                if r['type'] == 'storage' and r['storage'] not in shared | {'local'}}
    storage_names = sorted({name for (_, name) in storages})

    header = (["NODE", "STATUS", "CPU", "MEMORY", "ROOT DISK"]
              + [name.upper() for name in storage_names] + ["UPTIME"])
    rows = []
    for node in nodes:
        row = [node['node'], node['status']]
        if node['status'] == 'online':
            row += [f"{100 * node['cpu']:.0f}% of {node['maxcpu']} cores",
                    usage(node['mem'], node['maxmem']),
                    usage(node['disk'], node['maxdisk'])]
        else:
            row += ["-"] * 3
        for name in storage_names:
            st = storages.get((node['node'], name))
            row.append(usage(st['disk'], st['maxdisk']) if st and st['status'] == 'available' else "-")
        row.append(f"{node['uptime'] // 86400} days" if node['status'] == 'online' else "-")
        rows.append(row)
    print_table(header, rows)


###########################################
def completion_cache_path(args):
    cache_dir = os.environ.get('XDG_CACHE_HOME') or os.path.join(os.path.expanduser('~'), '.cache')
    return os.path.join(cache_dir, 'pokemon', f"vms-{args.profile or 'default'}.json")


def invalidate_completion_cache(args):
    try:
        os.remove(completion_cache_path(args))
    except OSError:
        pass


def complete_vms(args, status):
    """complete_vms(args, status) -> prints names of VMs with the given status (all if None)

Used by shell completion; the list of VMs is cached for COMPLETION_CACHE_TTL seconds.
"""
    path = completion_cache_path(args)
    vms = None
    try:
        if time.time() - os.path.getmtime(path) < COMPLETION_CACHE_TTL:
            with open(path) as f:
                vms = json.load(f)
    except (OSError, ValueError):
        pass

    if vms is None:
        vms = [{'name': vm['name'], 'status': vm['status']} for vm in get_vms(args)]
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with tempfile.NamedTemporaryFile('w', dir=os.path.dirname(path), delete=False) as f:
                json.dump(vms, f)
            os.replace(f.name, path)
        except OSError:
            pass

    for vm in vms:
        if status in (None, vm['status']):
            print(vm['name'])


ZSH_COMPLETION = r'''_pokemon() {
  local -a cmds
  cmds=(
    'list:list VMs'
    'cluster:show nodes of the cluster'
    'connect:connect to a VM'
    'mount:mount a VM filesystem via sshfs'
    'start:start a VM'
    'stop:shut a VM down'
    'rm:remove a VM'
    'completion:print a shell completion script'
  )
  local cmd= profile= skip= nargs=0 i w vm_status
  for (( i = 2; i < CURRENT; i++ )); do
    w=${words[i]}
    if [[ -n $skip ]]; then
      [[ $skip == profile ]] && profile=$w
      skip=
      continue
    fi
    case $w in
      --profile) skip=profile ;;
      --profile=*) profile=${w#--profile=} ;;
      -l|--user|-o|-t|--timeout) skip=1 ;;
      -*) ;;
      *) if [[ -z $cmd ]]; then cmd=$w; else (( nargs++ )); fi ;;
    esac
  done
  [[ -n $skip ]] && return 1    # completing the value of an option

  if [[ -z $cmd ]]; then
    _describe 'command' cmds
    return
  fi
  case $cmd in
    connect|mount|stop) vm_status=running ;;
    start|rm) vm_status=stopped ;;
    completion) (( nargs == 0 )) && compadd bash zsh; return ;;
    *) return 1 ;;
  esac
  if (( nargs == 0 )); then
    local -a vms
    vms=(${(f)"$(pokemon __complete $vm_status $profile 2>/dev/null)"})
    compadd -a vms
  elif [[ $cmd == mount ]] && (( nargs == 2 )); then
    _files -/
  fi
}
